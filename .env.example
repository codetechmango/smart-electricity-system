# ==============================================================================
# SMART ELECTRICITY SYSTEM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Port for running the backend server locally (default: 8000)
PORT=8000

# Database URL connection string.
# - SQLite (local dev): sqlite:///./electricity.db
# - PostgreSQL (production): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./electricity.db

# Secret key used to sign and verify JWT authentication tokens.
# Use a strong randomly generated string in production! (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=smart-electricity-dev-secret-change-me

# Expiration time for access tokens in minutes (default: 1440 mins = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed origins for CORS. Use specific URLs in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
# Base URL pointing to the FastAPI backend API endpoints.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
